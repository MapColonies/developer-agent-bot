# Copy to `.env` and fill in. `.env` is gitignored — never commit a filled-in copy.
#
#   cp .env.example .env
#
# Used by the "Dry run (sdk auth)" VS Code launch config and `npm run dry-run:local`.
# The deployed worker reads these from the pod's env instead; see helm/values.yaml.

# --- Jira, through the self-hosted atlassian-write MCP server. Needs the corporate VPN. ---
MCP_ATLASSIAN_URL=https://atlassian-mcp-write.mapcolonies.net/sse
JIRA_BOT_ACCOUNT=developer-agent@mapcolonies.net
JIRA_BOT_DISPLAY_NAME=AGENT DEVELOPER

# --- Which account pays for the model. `sdk` reads CLAUDE_CODE_OAUTH_TOKEN, ---
# --- `api-key` reads ANTHROPIC_API_KEY. The worker refuses the other mode's credential. ---
MODEL_AUTH=sdk
# From `claude setup-token`. Bills, and is rate-limited as, the person whose token it is.
CLAUDE_CODE_OAUTH_TOKEN=
# Only for MODEL_AUTH=api-key. Leave empty in sdk mode.
ANTHROPIC_API_KEY=

# --- Repo lookups, the clone, the push and the pull request. `gh auth token` prints one. ---
GITHUB_TOKEN=

# --- Spend ceilings. Deliberately far below the defaults for a laptop run: ---
# --- MAX_TICKETS_PER_DAY is counted per process, so each dry run gets its own allowance. ---
MAX_TOKENS_PER_TICKET=150000
MAX_TURNS_PER_TICKET=15
MAX_TICKETS_PER_DAY=1
