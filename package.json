{
  "name": "developer-agent-bot",
  "version": "0.1.0",
  "description": "Pulls agent-ready Jira tickets, implements them, and opens pull requests",
  "main": "./src/index.ts",
  "scripts": {
    "test:unit": "vitest run --coverage.enabled=false --project unit",
    "test:integration": "vitest run --coverage.enabled=false --project integration",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:ui": "vitest --ui",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "prelint:fix": "npm run format:fix",
    "prelint": "npm run format",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "prebuild": "npm run clean",
    "build": "tsc --project tsconfig.build.json && tsc-alias -p tsconfig.build.json && npm run assets:copy",
    "start": "npm run build && cd dist && node --import ./instrumentation.mjs ./index.js",
    "start:dev": "npm run build && cd dist && cross-env CONFIG_OFFLINE_MODE=true node --enable-source-maps --import ./instrumentation.mjs ./index.js",
    "assets:copy": "copyfiles -f ./config/* ./dist/config && copyfiles ./package.json dist",
    "clean": "rimraf dist",
    "prepare": "node .husky/install.mjs",
    "dry-run": "tsx src/dryRun.ts"
  },
  "directories": {
    "test": "tests"
  },
  "author": "MapColonies",
  "license": "ISC",
  "dependencies": {
    "@map-colonies/config": "^4.0.1",
    "@map-colonies/js-logger": "^5.0.0",
    "@map-colonies/prometheus": "^1.0.0",
    "@map-colonies/read-pkg": "^2.0.0",
    "@map-colonies/schemas": "^1.21.0",
    "@map-colonies/tracing": "^1.0.0",
    "@map-colonies/tracing-utils": "^1.0.0",
    "@modelcontextprotocol/sdk": "^1.22.0",
    "@opentelemetry/api": "^1.9.1",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "tsyringe": "^4.8.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.4.1",
    "@map-colonies/commitlint-config": "^2.0.0",
    "@map-colonies/eslint-config": "^8.0.0",
    "@map-colonies/prettier-config": "^1.0.0",
    "@map-colonies/tsconfig": "^2.0.0",
    "@vitest/coverage-v8": "^4.0.18",
    "@vitest/eslint-plugin": "^1.6.19",
    "@vitest/ui": "^4.1.8",
    "copyfiles": "^2.4.1",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.2",
    "husky": "^9.1.7",
    "prettier": "^3.8.3",
    "pretty-quick": "^4.2.2",
    "rimraf": "^6.1.3",
    "tsc-alias": "^1.8.17",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
